# Use a backend owned by this project. Run `pnpm exec convex dev` for local setup.
# Production builds must point at the matching production Convex deployment.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Public browser identifiers. Leave either blank to disable that service.
# Create these in the corresponding Cloudflare Web Analytics and Sentry projects.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
VITE_SENTRY_DSN=
d